# api-gateway: the only public backend entry point
PORT=8080
SPRING_PROFILES_ACTIVE=prod
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
REDIS_URL=redis://localhost:6379
# Comma-separated exact origins of the frontend (no wildcards)
CORS_ALLOWED_ORIGINS=http://localhost:3000
USER_SERVICE_URL=http://localhost:8081
POST_SERVICE_URL=http://localhost:8082
COMMENT_SERVICE_URL=http://localhost:8083
SEARCH_SERVICE_URL=http://localhost:8084
NOTIFICATION_SERVICE_URL=http://localhost:8085
# Token bucket per user (or per IP when anonymous)
RATE_LIMIT_PER_SECOND=20
RATE_LIMIT_BURST=40
# Stricter bucket per IP for /api/auth/** (login, register, refresh)
AUTH_RATE_LIMIT_PER_SECOND=1
AUTH_RATE_LIMIT_BURST=10
