# user-service: auth (issues JWTs), profiles, follows, skills, badges, leaderboard
PORT=8081
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://localhost:5432/userdb
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_POOL_SIZE=10
# Shared by ALL services and the gateway. >= 32 bytes. Generate: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
# Access token 15 min, refresh token 7 days (milliseconds)
JWT_ACCESS_TTL_MS=900000
JWT_REFRESH_TTL_MS=604800000
# Shared by all services for /internal/** calls. >= 16 chars. Generate: openssl rand -hex 32
INTERNAL_API_TOKEN=change-me-internal-token
NOTIFICATION_SERVICE_URL=http://localhost:8085
# Redis for caching (rediss:// for TLS, e.g. Upstash). CACHE_TYPE=none disables caching.
REDIS_URL=redis://localhost:6379
CACHE_TYPE=redis
