# post-service: posts, tags, likes, bookmarks, trending, full-text search
PORT=8082
SPRING_PROFILES_ACTIVE=prod
DB_URL=jdbc:postgresql://localhost:5432/postdb
DB_USERNAME=postgres
DB_PASSWORD=change-me
DB_POOL_SIZE=10
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-bytes
INTERNAL_API_TOKEN=change-me-internal-token
USER_SERVICE_URL=http://localhost:8081
REDIS_URL=redis://localhost:6379
CACHE_TYPE=redis
# Optional: image uploads. Leave empty to disable (upload endpoint returns 503).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
