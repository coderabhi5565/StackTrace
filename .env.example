# Root .env for docker compose (optional locally; compose has dev-only defaults).
# Generate secrets: openssl rand -base64 48   /   openssl rand -hex 32
JWT_SECRET=
INTERNAL_API_TOKEN=
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
SPRING_PROFILES_ACTIVE=prod
CORS_ALLOWED_ORIGINS=http://localhost:3000
COOKIE_SECURE=false
# Optional image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Host ports
GATEWAY_PORT=8080
FRONTEND_PORT=3000
